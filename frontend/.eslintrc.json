{
  "root": true,
  "ignorePatterns": [
    "projects/**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "parserOptions": {
        "project": [
          "tsconfig.json"
        ],
        "createDefaultProgram": true
      },
      "extends": [
        "plugin:@angular-eslint/recommended",
        "plugin:@angular-eslint/template/process-inline-templates"
      ],
      "rules": {
        "@angular-eslint/component-class-suffix": [
          "error",
          {
            "suffixes": [
              "Page",
              "Component"
            ]
          }
        ],
        "@angular-eslint/component-selector": [
          "error",
          {
            "type": "element",
            "prefix": "app",
            "style": "kebab-case"
          }
        ],
        "@angular-eslint/directive-selector": [
          "error",
          {
            "type": "attribute",
            "prefix": "app",
            "style": "camelCase"
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "posthog-js",
                "message": "Import posthog-js only in src/app/services/analytics/posthog.adapter.ts. Everything else must go through AnalyticsService, which is where opt-out, sanitizing and the never-break-a-flow guarantee live."
              }
            ],
            "patterns": [
              {
                "group": [
                  "posthog-js/*"
                ],
                "message": "Import posthog-js only in src/app/services/analytics/posthog.adapter.ts. Everything else must go through AnalyticsService."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "*.html"
      ],
      "extends": [
        "plugin:@angular-eslint/template/recommended"
      ],
      "rules": {}
    },
    {
      "files": [
        "src/app/services/analytics/posthog.adapter.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
